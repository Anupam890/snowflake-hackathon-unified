# Agents 
# INS_AGENT=RAG_DOC_AGENT

# Cortex Search service backing the document upload / retrieval flow.
# Must match the service created by docs/setup_document_pipeline.sql;
# refresh_document_search_service() issues ALTER ... REFRESH against this name.
SEARCH_SERVICE=INSURANCE_SEARCH_SVC

# Maximum number of ~1000-character sections embedded per uploaded document.
# Each section costs one CORTEX.EMBED_TEXT_768 call, so this bounds ingest time and
# spend. Anything beyond the cap is NOT searchable, and the upload chip reports the
# truncation rather than hiding it. Default 400 (~340k characters).
MAX_DOC_CHUNKS=400

